# Claude API (필수)
ANTHROPIC_API_KEY=sk-ant-...
# 모델 (선택, 기본 claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5
# 워크스페이스 ID (조건부). 콘솔에서 만든 키가 "워크스페이스에 묶이지 않은 키"면
# API 가 400 "must include the anthropic-workspace-id header" 를 돌려준다.
# 콘솔 Settings → Workspaces 의 ID(wrkspc_...)를 넣거나, 워크스페이스 범위 키를 새로 만들면 비워 둬도 된다.
ANTHROPIC_WORKSPACE_ID=

# 공무원 화면 비밀번호 (기본 yangju2026)
ADMIN_PASSWORD=change-me

# Supabase (선택: 없으면 data/db.json 파일 저장소 사용 — 로컬 개발·시연용)
# Vercel 배포 시에는 반드시 설정 (서버리스는 파일 쓰기가 유지되지 않음)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 공공데이터포털 인증키 (선택: npm run load-accidents 에만 사용)
# data.go.kr 에서 "한국도로교통공단_어린이보호구역내 어린이 교통사고 다발지역"(15058311) 활용신청 → 일반 인증키(Decoding)
DATA_GO_KR_KEY=
